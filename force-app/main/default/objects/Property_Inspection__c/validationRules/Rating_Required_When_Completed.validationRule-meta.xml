<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rating_Required_When_Completed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Inspection_Status__c,&quot;Completed&quot;),
    ISBLANK(Overall_Rating__c)
)</errorConditionFormula>
    <errorDisplayField>Overall_Rating__c</errorDisplayField>
    <errorMessage>Rating field is required when Status is &quot;Completed&quot;</errorMessage>
</ValidationRule>
